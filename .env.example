# App
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Web のサーバー側（SSR・server action）から呼ぶ API の URL。ブラウザと宛先が異なる場合のみ（例: Docker では http://api:4000）
API_INTERNAL_URL=
# API の CORS 許可オリジン（未設定 = * ）
WEB_ORIGIN=http://localhost:3000
# API の trust proxy（クライアント IP 判定・レート制限用）: 未設定/false = 直結, 数値 = 信頼するプロキシ段数（Cloudflare→ALB なら 2）, IP/CIDR のカンマ区切りも可
TRUST_PROXY=

# Database (PostgreSQL)
DATABASE_URL=postgresql://app:localpassword@localhost:5432/foreign_service_dev?schema=public

# Cache (Optional in Phase1: empty = in-memory LRU cache, set URL = Valkey/Redis)
REDIS_URL=

# AWS / Cognito
AWS_REGION=ap-northeast-1
# 管理者認証: cognito（既定）| dev = 固定管理者で通過（ローカル専用。NODE_ENV=production では起動不可）
AUTH_MODE=dev
COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Web の管理ログイン（Cognito Hosted UI のドメイン。例: https://<prefix>.auth.ap-northeast-1.amazoncognito.com）
COGNITO_DOMAIN=
# Hosted UI のコールバック先を組み立てる Web の公開 URL
WEB_BASE_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mail（お問い合わせ通知）: log = ログ出力のみ（既定） | ses = Amazon SES v2
MAIL_DRIVER=log
# ses 使用時の送信元（SES で検証済みのアドレス）
MAIL_FROM=
# お問い合わせの運営通知先（未設定 = 通知しない）
MAIL_OPERATOR_TO=

# 収集した事業者への掲載案内（F-118）。既定は無効。有効にすると送信者情報・署名鍵・WEB_ORIGIN が必須（欠けていると API が起動しない）
OUTREACH_ENABLED=false
# 1 日（日本時間）の送信上限
OUTREACH_DAILY_LIMIT=10
# 掲載申請フォームの事前入力リンクの有効日数
OUTREACH_LINK_TTL_DAYS=30
# メールに表示する送信者の名称・住所・連絡先（特定電子メール法の表示事項）
OUTREACH_SENDER_NAME=
OUTREACH_SENDER_ADDRESS=
OUTREACH_SENDER_CONTACT=
# リンクの署名鍵（32 文字以上のランダムな値。無効にした後も受信拒否リンクの検証に使うため変更しない）
OUTREACH_LINK_SECRET=

# 画像アップロード（F-107）: local = API が受け付けて uploads/ に保存（既定）| s3 = S3 presigned PUT
STORAGE_DRIVER=local
# s3 使用時のバケット
S3_BUCKET=
# 画像の配信元（CDN の URL。s3 使用時は必須）。未設定 = API_PUBLIC_URL/uploads
ASSET_BASE_URL=
# ブラウザから見た API の URL（local のアップロード URL・画像 URL の組み立てに使う）
API_PUBLIC_URL=http://localhost:4000
# local の保存先ディレクトリ
LOCAL_UPLOAD_DIR=uploads
# Web の CSP connect-src に追加する画像 PUT 先（s3 使用時: https://<bucket>.s3.<region>.amazonaws.com。web のビルド時に参照）
UPLOAD_ORIGIN=

# データ収集（F-111, apps/collector）。既定はベトナム人向け・全地域・全カテゴリ・法人と公的機関のみ。
# 件数・負荷・保存は POC 最小。上限は運用しながら上げる（apps/collector/README.md）
# 収集対象カテゴリ（カンマ区切り or all）
COLLECTOR_CATEGORIES=all
# 収集対象の都道府県コード（カンマ区切り or all）
COLLECTOR_PREFECTURES=all
# corporate_public = 法人と公的機関のみ | corporate = 法人のみ | all = すべて（個人事業主は同意後に公開）
COLLECTOR_ENTITY_SCOPE=corporate_public
# 重点対象の言語（en / zh / vi のカンマ区切り）
COLLECTOR_TARGET_LANGUAGES=vi
# prioritize = 対象言語の根拠がある候補を優先 | require = 根拠がある候補だけ保存
COLLECTOR_TARGET_LANGUAGE_MODE=prioritize
# 1 回の実行で保存する候補の上限（超過分は次回）
COLLECTOR_MAX_CANDIDATES_PER_RUN=100
# 公式サイトのクロール（F-115）
COLLECTOR_CRAWL_ENABLED=false
COLLECTOR_CRAWL_MAX_SITES_PER_RUN=20
COLLECTOR_CRAWL_MAX_PAGES=3
# 同一ドメインへの最小間隔（秒、5 未満は不可）
COLLECTOR_CRAWL_INTERVAL_SEC=10
COLLECTOR_RECRAWL_DAYS=30
# 未設定 = bizshow-collector/0.1 (+${WEB_BASE_URL}/bot)
COLLECTOR_USER_AGENT=
# LLM による構造化抽出・説明文の下書き（F-117）。有効・予算 > 0・モデル・API キーが揃ったときだけ使う
COLLECTOR_LLM_ENABLED=false
# 月額の上限（円、日本時間の月ごと）。0 は利用しない。到達後は呼ばずにスキップする
COLLECTOR_LLM_MONTHLY_BUDGET_JPY=0
# Anthropic のモデル ID
COLLECTOR_LLM_MODEL=
# 概算費用の単価（円 / 100 万トークン）。実際の単価より高めにすると予算を超えにくい
COLLECTOR_LLM_PRICE_IN_PER_MTOK_JPY=500
COLLECTOR_LLM_PRICE_OUT_PER_MTOK_JPY=2500
# Anthropic の API キー（コミットしない。本番は SSM から注入）
ANTHROPIC_API_KEY=
# 法人番号 API のアプリケーション ID（空 = 法人番号の照合をしない）
CORPORATE_NUMBER_API_ID=
# 名寄せの名称類似度の閾値（0〜1, F-114）
COLLECTOR_MATCH_NAME_THRESHOLD=0.8
# 確認できない掲載を非公開候補として一覧する日数
COLLECTOR_STALE_DAYS=180
# 生データの保存日数・保存先（ローカル。S3 は D-006）
COLLECTOR_RAW_RETENTION_DAYS=30
COLLECTOR_RAW_DIR=collector-raw
