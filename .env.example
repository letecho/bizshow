# App
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Web のサーバー側（SSR・server action）から呼ぶ API の URL。ブラウザと宛先が異なる場合のみ（例: Docker では http://api:4000）
API_INTERNAL_URL=
# API の CORS 許可オリジン（未設定 = * ）
WEB_ORIGIN=http://localhost:3000
# API の trust proxy（クライアント IP 判定・レート制限用）: 未設定/false = 直結, 数値 = 信頼するプロキシ段数（Cloudflare→ALB なら 2）, IP/CIDR のカンマ区切りも可
TRUST_PROXY=

# Database (PostgreSQL)
DATABASE_URL=postgresql://app:localpassword@localhost:5432/foreign_service_dev?schema=public

# Cache (Optional in Phase1: empty = in-memory LRU cache, set URL = Valkey/Redis)
REDIS_URL=

# AWS / Cognito
AWS_REGION=ap-northeast-1
# 管理者認証: cognito（既定）| dev = 固定管理者で通過（ローカル専用。NODE_ENV=production では起動不可）
AUTH_MODE=dev
COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Web の管理ログイン（Cognito Hosted UI のドメイン。例: https://<prefix>.auth.ap-northeast-1.amazoncognito.com）
COGNITO_DOMAIN=
# Hosted UI のコールバック先を組み立てる Web の公開 URL
WEB_BASE_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mail（お問い合わせ通知）: log = ログ出力のみ（既定） | ses = Amazon SES v2
MAIL_DRIVER=log
# ses 使用時の送信元（SES で検証済みのアドレス）
MAIL_FROM=
# お問い合わせの運営通知先（未設定 = 通知しない）
MAIL_OPERATOR_TO=

# 画像アップロード（F-107）: local = API が受け付けて uploads/ に保存（既定）| s3 = S3 presigned PUT
STORAGE_DRIVER=local
# s3 使用時のバケット
S3_BUCKET=
# 画像の配信元（CDN の URL。s3 使用時は必須）。未設定 = API_PUBLIC_URL/uploads
ASSET_BASE_URL=
# ブラウザから見た API の URL（local のアップロード URL・画像 URL の組み立てに使う）
API_PUBLIC_URL=http://localhost:4000
# local の保存先ディレクトリ
LOCAL_UPLOAD_DIR=uploads
# Web の CSP connect-src に追加する画像 PUT 先（s3 使用時: https://<bucket>.s3.<region>.amazonaws.com。web のビルド時に参照）
UPLOAD_ORIGIN=
