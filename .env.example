# App
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://app:localpassword@localhost:5432/foreign_service_dev?schema=public

# Cache (Optional in Phase1: empty = in-memory LRU cache, set URL = Valkey/Redis)
REDIS_URL=

# AWS / Cognito
AWS_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
