{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- prisma db seed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/client-sesv2": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@prisma/client": "^5.22.0",
    "aws-jwt-verify": "^5",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7",
    "helmet": "^8.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fss/shared": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^8",
    "prisma": "^5.22.0",
    "supertest": "^7.3.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
