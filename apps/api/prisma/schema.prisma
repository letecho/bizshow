generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServiceListing {
  id                 String   @id @default(cuid())
  slug               String   @unique
  /// SERVICE_CATEGORIES (packages/shared)
  category           String
  /// PREFECTURES[].code (packages/shared)
  prefecture         String
  city               String?
  /// SupportedLocale[]
  supportedLanguages String[]
  /// LocalizedText
  name               Json
  /// LocalizedText
  description        Json
  /// LocalizedText
  address            Json?
  phone              String?
  websiteUrl         String?
  /// 掲載画像のストレージキー（F-107）。配信は CDN 経由
  imageKey           String?
  /// 法人番号（13 桁、F-114 の名寄せに使う）
  corporateNumber    String?
  /// 出典（ListingSource[]: DataSource.attribution と sourceUrl、F-116）。手入力の掲載は null
  sources            Json?
  /// 掲載内容を最後に確認した日時（F-116）。収集の承認・再確認で更新する
  lastVerifiedAt     DateTime?
  /// 全言語の name + description を小文字で連結した検索用テキスト
  searchText         String
  isPublished        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([category, prefecture])
  @@index([isPublished])
  @@index([corporateNumber])
}

/// お問い合わせ（F-103）
model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  /// 送信時の表示言語（SupportedLocale）
  locale    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum ListingRequestStatus {
  pending
  approved
  rejected
}

/// 事業者の掲載申請（F-104）。承認で ServiceListing を作成する（F-106）
model ListingRequest {
  id                 String               @id @default(cuid())
  status             ListingRequestStatus @default(pending)
  /// SERVICE_CATEGORIES (packages/shared)
  category           String
  /// PREFECTURES[].code (packages/shared)
  prefecture         String
  city               String?
  /// SupportedLocale[]
  supportedLanguages String[]
  /// LocalizedText
  name               Json
  /// LocalizedText
  description        Json
  /// LocalizedText
  address            Json?
  phone              String?
  websiteUrl         String?
  contactName        String
  contactEmail       String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status, createdAt])
}

// ---- データ収集基盤（F-111）。収集は掲載候補を作るだけで、ServiceListing は管理者の承認で作る ----

enum DataSourceKind {
  open_data
  api
  crawl
  partner
}

/// 収集元（オープンデータ・API・クロール・提携先）。id は collector のアダプター名と一致させる
model DataSource {
  id          String             @id
  kind        DataSourceKind
  name        String
  url         String
  license     String
  /// 出典表示の文言（F-116）
  attribution String
  /// 実行間隔の目安（例: monthly）。実際の起動は Scheduler（D-006）
  schedule    String?
  isEnabled   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  runs        CollectionRun[]
  candidates  ServiceCandidate[]
}

enum CollectionRunStatus {
  running
  succeeded
  failed
}

/// 収集の実行履歴（件数のみ。対象外で保存しなかった候補の内容は記録しない）
model CollectionRun {
  id                     String              @id @default(cuid())
  sourceId               String
  source                 DataSource          @relation(fields: [sourceId], references: [id])
  startedAt              DateTime            @default(now())
  finishedAt             DateTime?
  status                 CollectionRunStatus @default(running)
  fetchedCount           Int                 @default(0)
  candidateCount         Int                 @default(0)
  skippedByLimitCount    Int                 @default(0)
  skippedByLanguageCount Int                 @default(0)
  skippedByEntityCount   Int                 @default(0)
  errorCount             Int                 @default(0)
  /// エラーの例（レコード ID と項目名のみ。収集した内容・個人情報は含めない）
  errorSample            String?

  @@index([sourceId, startedAt])
}

enum CandidateEntityType {
  corporation
  public
  individual
  unknown
}

enum CandidateMatchType {
  new
  update
  duplicate
}

enum CandidateStatus {
  pending
  approved
  rejected
  on_hold
}

/// 掲載候補。管理者がレビューして承認したものだけ ServiceListing にする（F-113）
model ServiceCandidate {
  id                String              @id @default(cuid())
  sourceId          String
  source            DataSource          @relation(fields: [sourceId], references: [id])
  sourceUrl         String?
  /// 収集元でのレコード ID（再実行で重複させないキー）
  sourceRecordId    String
  fetchedAt         DateTime
  /// 生データの保存キー（COLLECTOR_RAW_DIR / S3）
  rawKey            String?
  /// CandidateExtract (packages/shared)
  extracted         Json
  /// LanguageEvidence[] (packages/shared)
  languageEvidence  Json
  /// COLLECTOR_TARGET_LANGUAGES の根拠があるか
  hasTargetLanguage Boolean             @default(false)
  entityType        CandidateEntityType
  /// EntityEvidence[] (packages/shared)
  entityEvidence    Json
  corporateNumber   String?
  matchedListingId  String?
  matchType         CandidateMatchType  @default(new)
  /// 0〜100（F-114）
  score             Int                 @default(0)
  /// LLM で空欄を補完した項目（F-117）。管理者の確認が必要
  llmFilledFields   String[]            @default([])
  status            CandidateStatus     @default(pending)
  reviewNote        String?
  reviewedBy        String?
  reviewedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([sourceId, sourceRecordId])
  @@index([status, hasTargetLanguage, score])
}

enum CrawlBlockReason {
  optout
  terms
  robots
}

/// 収集・クロールの対象外（F-116）。登録済みのドメイン（サブドメインを含む）・法人番号は候補を作らない
model CrawlBlocklist {
  id              String           @id @default(cuid())
  domain          String?
  corporateNumber String?
  reason          CrawlBlockReason
  note            String?
  createdAt       DateTime         @default(now())

  @@index([domain])
  @@index([corporateNumber])
}

/// LLM の呼び出しごとの使用量（F-117）。当月の costJpy の合計が COLLECTOR_LLM_MONTHLY_BUDGET_JPY に達したら呼ばない
model LlmUsage {
  id        String   @id @default(cuid())
  /// YYYY-MM（日本時間）
  month     String
  /// extract | description_draft
  purpose   String
  model     String
  tokensIn  Int
  tokensOut Int
  /// 概算費用（円）。COLLECTOR_LLM_PRICE_*_PER_MTOK_JPY で計算
  costJpy   Float
  createdAt DateTime @default(now())

  @@index([month])
}
