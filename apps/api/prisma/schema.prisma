generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServiceListing {
  id                 String   @id @default(cuid())
  slug               String   @unique
  /// SERVICE_CATEGORIES (packages/shared)
  category           String
  /// PREFECTURES[].code (packages/shared)
  prefecture         String
  city               String?
  /// SupportedLocale[]
  supportedLanguages String[]
  /// LocalizedText
  name               Json
  /// LocalizedText
  description        Json
  /// LocalizedText
  address            Json?
  phone              String?
  websiteUrl         String?
  /// 全言語の name + description を小文字で連結した検索用テキスト
  searchText         String
  isPublished        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([category, prefecture])
  @@index([isPublished])
}

/// お問い合わせ（F-103）
model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  /// 送信時の表示言語（SupportedLocale）
  locale    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
